---
import Layout from "../layouts/Layout.astro";
import Card from "../components/Card.astro";
import { getCollection } from "astro:content";
import { RiBlueskyLine, RiGithubLine } from "react-icons/ri";
import { CiMail } from "react-icons/ci";
import Post from "../components/Post.astro";
import { Image } from "astro:assets";

const intro =
  "Welcome to my corner of the internet ! Writing about stuff I learn, make and discover.";
const email = "mailto:" + "contact@devinda.me";
const github = "https://github.com/" + "dca123";
const bluesky = "https://bsky.app/profile/devinda.me";
//const resume = "https://devinda.me/resume";
const projects = await getCollection("projects");
---

<Layout title="Devinda Senanayake">
  <main class="pt-7 pb-10 flex">
    <div class="flex flex-col space-y-4 w-2/3">
      <div class="w-full">
        <div class="space-y-2">
          <h1 class="font-light text-xl font-title">Hi,</h1>
          <h1 class="font-light text-2xl font-title">I'm</h1>
          <h1 class="font-black font-title text-5xl">Devinda</h1>
        </div>
        <div class="rounded mt-4 w-fit">
          <p>
            {intro}
          </p>
        </div>
        <div
          class="flex justify-between mt-5 mx-4 items-center md:justify-start md:space-x-8 md:mx-0"
        >
          <a
            class="group bg-background border border-transparent transition-colors pr-2 py-2 rounded"
            href={github}
            target="_blank"
            aria-label="Github"
          >
            <RiGithubLine
              className="h-7 w-7 flex-no-shrink fill-current text-gray-100 group-hover:text-border"
              fill="none"
            />
          </a>
          <a
            class="group bg-background border border-transparent transition-colors pr-2 py-2 rounded"
            href={bluesky}
            target="_blank"
            aria-label="Bluesky"
          >
            <RiBlueskyLine
              className="h-7 w-7 flex-no-shrink fill-current text-gray-100 group-hover:text-border"
              fill="none"
            />
          </a>
          <a
            class="group bg-background border border-transparent transition-colors pr-2 py-2 rounded"
            href={email}
            target="_blank"
            aria-label="Email"
          >
            <CiMail
              className="h-7 w-7 flex-no-shrink fill-current text-gray-100 group-hover:text-border"
              fill="none"
            />
          </a>
        </div>
      </div>

      <div class="w-full">
        <h1 class="font-normal text-xl mt-2 font-title tracking-wider">
          Posts
        </h1>
        <div class="mt-2 space-y-5">
          {
            Array.from({ length: 5 }).map((_, idx) => (
              <Post title={idx.toString()} />
            ))
          }
        </div>
      </div>
    </div>
    <div class="mt-8 flex flex-col space-y-4 w-1/3 relative">
      <div class="w-full">
        <h1 class="font-normal text-xl mt-2 font-title tracking-wider">
          Photography
        </h1>
        <div class="overflow-x-auto">
          <div class="mt-2 grid grid-flow-col grid-rows-2 gap-4 w-[600px]">
            <Image
              src={"https://picsum.photos/200?random=1"}
              class="h-[200px] w-[200px] rounded object-cover"
              alt=""
              width={200}
              height={200}
            />
            <Image
              src={"https://picsum.photos/200?random=2"}
              class="h-full w-full rounded object-cover"
              alt=""
              width={200}
              height={200}
            />
            <Image
              src={"https://picsum.photos/200?random=3"}
              class="h-full w-full rounded object-cover"
              alt=""
              width={200}
              height={200}
            />
            <Image
              src={"https://picsum.photos/200?random=4"}
              class="h-full w-full rounded object-cover"
              alt=""
              width={200}
              height={200}
            />
            <Image
              src={"https://picsum.photos/200?random=5"}
              class="h-full w-full rounded object-cover"
              alt=""
              width={200}
              height={200}
            />
            <Image
              src={"https://picsum.photos/200?random=6"}
              class="h-full w-full rounded object-cover"
              alt=""
              width={200}
              height={200}
            />
          </div>
        </div>
      </div>
      <div>
        <h1 class="font-normal text-xl mt-2 font-title tracking-wider">
          Playlists
        </h1>
        <div class="relative mt-2">
          <div class="relative perspective-[2000px] perspective-origin-top">
            <Image
              src={"https://picsum.photos/800?random=5"}
              class="top-0 absolute size-64 rounded object-cover hover:-rotate-x-[30deg] hover:translate-y-[20px] transition-all vinyl"
              alt=""
              width={200}
              height={200}
            />
          </div>
        </div>
      </div>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mt-4">
      {
        projects.map((entry) => {
          const project = entry.data.props;
          return (
            <Card
              title={project.title}
              description={project.description}
              skills={project.skills}
              slug={project.slug}
              cover={project.cover}
            />
          );
        })
      }
    </div>
  </main>
</Layout>

<style>
  .vinyl {
    transform-style: preserve-3d;
  }
</style>

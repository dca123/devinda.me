---
import { Image } from "astro:assets";

interface Props {
  title: string;
  description: string;
  skills: string[];
  slug: string;
  cover: string;
}

const { title } = Astro.props;
---

<div class="flex flex-row space-x-6 group cursor-pointer">
  <div class="basis-1/3">
    <Image
      src={`https://picsum.photos/200?random=${title}`}
      class="h-32 w-full rounded object-cover"
      alt=""
      width={1080}
      height={200}
    />
  </div>
  <div class="basis-2/3">
    <h1
      class="font-bold group-hover:underline group-hover:text-accent-foreground"
    >
      Toggle between two applications on MacOS
    </h1>
    <h2 class="">Switch between two named windows with a keypress</h2>
  </div>
</div>

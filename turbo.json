{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".astro/**", "out/**"],
      "env": [
        "CLOUDINARY_URL",
        "NOTION_API_KEY",
        "NOTION_TOKEN",
        "SOUNDCLOUD_CLIENT_ID",
        "SOUNDCLOUD_OAUTH"
      ]
    },
    "test": {
      "dependsOn": ["build"],
      "env": ["VITE_NOTION_API_KEY", "NOTION_API_KEY"]
    },
    "lint": {},
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
